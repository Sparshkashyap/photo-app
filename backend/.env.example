# Environment variables template
# Copy this file to .env and fill in the actual values

NODE_ENV=development

# JWT Configuration
JWT_SECRET=
JWT_EXPIRY=24h

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database
DYNAMODB_TABLE=PhotoTable

# S3
S3_BUCKET=photo-app-bucket

# Server
PORT=3000
